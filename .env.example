# Firestore emulator (Phase 1 — local)
FIRESTORE_EMULATOR_HOST=localhost:8080

# Pub/Sub emulator (Phase 1 — local)
PUBSUB_EMULATOR_HOST=localhost:8085

# No real GCP project ID is required for the emulator, any name works
GCP_PROJECT_ID=anamnesis-local

# Vertex AI / Gemini Enterprise (real GCP project — used by the ADK agent, not the emulators)
GOOGLE_GENAI_USE_ENTERPRISE=1
GOOGLE_CLOUD_PROJECT=gen-lang-client-0424267124
GOOGLE_CLOUD_LOCATION=us-central1

# Encrypts per-user GitHub and Jira credentials before they're stored in
# Firestore (APPCE-79, APPCE-87) — GitHub/Jira themselves are connected
# per-user from the app's Settings dialog, not via env vars.
# Fetch the real value after `task secrets:github-key:init` has run once:
#   task secrets:github-key:pull
GITHUB_TOKEN_ENCRYPTION_KEY=
