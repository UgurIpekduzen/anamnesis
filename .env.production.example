# Points one-off scripts (seeding real Firestore data, checking the stored
# tokens against the key, ...) at real GCP instead of the local emulators.
# The FIRESTORE_EMULATOR_HOST / PUBSUB_EMULATOR_HOST variables of .env are
# deliberately absent here, so nothing is sent to an emulator.
#
# Copy it to .env.production and run a script with:
#   DOTENV_PATH=.env.production python seed_data.py
GCP_PROJECT_ID=your-gcp-project-id
